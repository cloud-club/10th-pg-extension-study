{
  "name": "pg-extension-study-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:animations": "bun scripts/check-animations.mjs",
    "check": "bun run typecheck && bun run check:animations && bun run check:navigation && bun run check:cron-data && bun run check:hstore-data && bun run check:pgvector-data && npm run check:fdw-guide && npm run check:fdw-data && npm run check:joins-guide && npm run check:fdw-review && npm run check:fdw-join-comparison && npm run check:hll-guide && npm run check:hll-data && npm run check:hll-storage && npm run check:hll-plots",
    "check:navigation": "bun scripts/check-navigation.ts",
    "check:cron-data": "python3 scripts/sync-cron-results.py --check",
    "check:hstore-data": "python3 scripts/sync-hstore-results.py --check",
    "check:pgvector-data": "python3 scripts/sync-pgvector-results.py --check",
    "check:pgvector-guide": "python3 scripts/sync-pgvector-guide.py --check",
    "deploy:cloudflare": "bun run check && bun run build && wrangler deploy",
    "check:fdw-guide": "python3 scripts/sync-fdw-guide.py --check",
    "check:fdw-data": "python3 scripts/sync-fdw-results.py --check",
    "check:joins-guide": "python3 scripts/sync-joins-guide.py --check",
    "check:fdw-review": "python3 scripts/check-fdw-review.py",
    "check:fdw-join-comparison": "python3 scripts/sync-fdw-join-comparison.py --check",
    "check:hll-guide": "python3 scripts/sync-hll-guide.py --check",
    "check:hll-data": "python3 scripts/sync-hll-results.py --check",
    "check:hll-storage": "python3 labs/hll/inspect-storage.py --check",
    "check:hll-plots": "python3 scripts/check-hll-plots.py"
  },
  "dependencies": {
    "@kokoa/clotho": "0.4.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "chart.js": "^4.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "11.11.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
